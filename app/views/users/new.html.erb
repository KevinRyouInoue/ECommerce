<div style="max-width: 400px; margin: 4rem auto; padding: 2rem; border: 1px solid #ddd; border-radius: 8px; background: white;">
  <h1 style="text-align: center; margin-bottom: 2rem;">Sign Up</h1>
  
  <%= form_with model: @user, url: signup_path, local: true do |f| %>
    <% if @user.errors.any? %>
      <div style="background: #f8d7da; color: #721c24; padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
        <h3 style="margin-top: 0;"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h3>
        <ul style="margin-bottom: 0;">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <div style="margin-bottom: 1.5rem;">
      <%= f.label :name, "Name", style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
      <%= f.text_field :name, required: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;" %>
    </div>
    
    <div style="margin-bottom: 1.5rem;">
      <%= f.label :email, "Email", style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
      <%= f.email_field :email, required: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;" %>
    </div>
    
    <div style="margin-bottom: 1.5rem;">
      <%= f.label :password, "Password", style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;" %>
    </div>
    
    <div style="margin-bottom: 1.5rem;">
      <%= f.label :password_confirmation, "Confirm Password", style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
      <%= f.password_field :password_confirmation, required: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;" %>
    </div>
    
    <%= f.submit "Sign Up", style: "width: 100%; padding: 0.75rem; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; font-weight: bold;" %>
  <% end %>
  
  <p style="text-align: center; margin-top: 1.5rem; color: #666;">
    Already have an account? <%= link_to "Login", login_path, style: "color: #007bff; text-decoration: none;" %>
  </p>
</div>
