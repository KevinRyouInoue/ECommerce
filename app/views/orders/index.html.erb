<h1>My Orders</h1>

<% if @orders.any? %>
  <div style="margin-top: 2rem;">
    <% @orders.each do |order| %>
      <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; background: white;">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
          <div>
            <h2 style="margin: 0 0 0.5rem 0;">Order #<%= order.id %></h2>
            <p style="color: #666; margin: 0;">Placed on <%= order.created_at.strftime("%B %d, %Y") %></p>
          </div>
          <div style="text-align: right;">
            <p style="margin: 0; font-size: 1.2rem; font-weight: bold; color: #28a745;">$<%= number_with_precision(order.total_amount, precision: 2) %></p>
            <p style="margin: 0.25rem 0 0 0; text-transform: capitalize; color: <%= order.status == 'delivered' ? '#28a745' : '#007bff' %>;"><%= order.status %></p>
          </div>
        </div>
        
        <div style="border-top: 1px solid #eee; padding-top: 1rem;">
          <h3 style="margin: 0 0 0.5rem 0; font-size: 1rem;">Items:</h3>
          <% order.order_items.limit(3).each do |item| %>
            <p style="color: #666; margin: 0.25rem 0;">• <%= item.product.name %> (x<%= item.quantity %>)</p>
          <% end %>
          <% if order.order_items.count > 3 %>
            <p style="color: #666; margin: 0.25rem 0;">...and <%= order.order_items.count - 3 %> more item(s)</p>
          <% end %>
        </div>
        
        <%= link_to "View Details", order_path(order), style: "display: inline-block; margin-top: 1rem; padding: 0.5rem 1.5rem; background: #007bff; color: white; text-decoration: none; border-radius: 4px;" %>
      </div>
    <% end %>
  </div>
<% else %>
  <div style="text-align: center; margin-top: 4rem;">
    <p style="color: #666; font-size: 1.2rem; margin-bottom: 2rem;">You haven't placed any orders yet</p>
    <%= link_to "Start Shopping", products_path, style: "padding: 1rem 2rem; background: #007bff; color: white; text-decoration: none; border-radius: 4px; font-size: 1.1rem;" %>
  </div>
<% end %>
