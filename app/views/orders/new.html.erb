<h1>Checkout</h1>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-top: 2rem;">
  <div>
    <h2>Shipping Information</h2>
    
    <%= form_with model: @order, url: orders_path, local: true do |f| %>
      <% if @order.errors.any? %>
        <div style="background: #f8d7da; color: #721c24; padding: 1rem; margin-bottom: 1rem; border-radius: 4px;">
          <h3 style="margin-top: 0;"><%= pluralize(@order.errors.count, "error") %> prohibited this order from being saved:</h3>
          <ul style="margin-bottom: 0;">
            <% @order.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div style="margin-bottom: 1.5rem;">
        <%= f.label :shipping_address, "Shipping Address", style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
        <%= f.text_area :shipping_address, required: true, rows: 5, placeholder: "Enter your full shipping address", style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;" %>
      </div>
      
      <h2>Order Items</h2>
      <% @cart_items.each do |item| %>
        <div style="border: 1px solid #ddd; border-radius: 4px; padding: 1rem; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <strong><%= item.product.name %></strong>
            <p style="margin: 0.25rem 0; color: #666;">Quantity: <%= item.quantity %> × $<%= number_with_precision(item.product.price, precision: 2) %></p>
          </div>
          <strong>$<%= number_with_precision(item.product.price * item.quantity, precision: 2) %></strong>
        </div>
      <% end %>
      
      <%= f.submit "Place Order", style: "width: 100%; padding: 1rem; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1.1rem; font-weight: bold; margin-top: 1rem;" %>
    <% end %>
  </div>
  
  <div>
    <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1.5rem; background: #f8f9fa; position: sticky; top: 1rem;">
      <h2 style="margin-top: 0;">Order Summary</h2>
      
      <div style="margin: 1rem 0;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Subtotal:</span>
          <span>$<%= number_with_precision(@total, precision: 2) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Shipping:</span>
          <span>Free</span>
        </div>
        <hr style="border: none; border-top: 1px solid #ddd; margin: 1rem 0;">
        <div style="display: flex; justify-content: space-between; font-size: 1.2rem; font-weight: bold;">
          <span>Total:</span>
          <span style="color: #28a745;">$<%= number_with_precision(@total, precision: 2) %></span>
        </div>
      </div>
    </div>
  </div>
</div>
