<div style="max-width: 400px; margin: 4rem auto; padding: 2rem; border: 1px solid #ddd; border-radius: 8px; background: white;">
  <h1 style="text-align: center; margin-bottom: 2rem;">Login</h1>
  
  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div style="margin-bottom: 1.5rem;">
      <%= label_tag :email, "Email", style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
      <%= email_field_tag :email, nil, required: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;" %>
    </div>
    
    <div style="margin-bottom: 1.5rem;">
      <%= label_tag :password, "Password", style: "display: block; margin-bottom: 0.5rem; font-weight: bold;" %>
      <%= password_field_tag :password, nil, required: true, style: "width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box;" %>
    </div>
    
    <%= f.submit "Login", style: "width: 100%; padding: 0.75rem; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; font-weight: bold;" %>
  <% end %>
  
  <p style="text-align: center; margin-top: 1.5rem; color: #666;">
    Don't have an account? <%= link_to "Sign up", signup_path, style: "color: #007bff; text-decoration: none;" %>
  </p>
</div>
