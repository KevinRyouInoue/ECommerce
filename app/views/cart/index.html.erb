<h1>Shopping Cart</h1>

<% if @cart_items.any? %>
  <div style="margin-top: 2rem;">
    <% @cart_items.each do |item| %>
      <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
        <% if item.product.image_url.present? %>
          <%= image_tag item.product.image_url, alt: item.product.name, style: "width: 100px; height: 100px; object-fit: cover; border-radius: 4px;" %>
        <% else %>
          <div style="width: 100px; height: 100px; background: #f0f0f0; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
            No Image
          </div>
        <% end %>
        
        <div style="flex: 1;">
          <h3 style="margin: 0 0 0.5rem 0;"><%= link_to item.product.name, product_path(item.product), style: "color: #333; text-decoration: none;" %></h3>
          <p style="color: #28a745; font-size: 1.1rem; font-weight: bold; margin: 0;">$<%= number_with_precision(item.product.price, precision: 2) %></p>
        </div>
        
        <div style="display: flex; align-items: center; gap: 1rem;">
          <%= form_with url: update_cart_quantity_path(item), method: :patch, local: true, style: "display: flex; align-items: center; gap: 0.5rem;" do |f| %>
            <%= number_field_tag :quantity, item.quantity, min: 1, max: item.product.stock_quantity, style: "padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; width: 80px;" %>
            <%= f.submit "Update", style: "padding: 0.5rem 1rem; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
          <% end %>
          
          <p style="margin: 0; min-width: 100px; text-align: right; font-weight: bold;">
            $<%= number_with_precision(item.product.price * item.quantity, precision: 2) %>
          </p>
          
          <%= button_to "Remove", remove_from_cart_path(item), method: :delete, style: "padding: 0.5rem 1rem; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
        </div>
      </div>
    <% end %>
    
    <div style="margin-top: 2rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
      <h2 style="margin-top: 0;">Order Summary</h2>
      <div style="display: flex; justify-content: space-between; font-size: 1.2rem; margin: 1rem 0;">
        <strong>Total:</strong>
        <strong style="color: #28a745;">$<%= number_with_precision(@total, precision: 2) %></strong>
      </div>
      
      <% if logged_in? %>
        <%= link_to "Proceed to Checkout", new_order_path, style: "display: block; text-align: center; padding: 1rem; background: #28a745; color: white; text-decoration: none; border-radius: 4px; font-size: 1.1rem; font-weight: bold;" %>
      <% else %>
        <p style="text-align: center; color: #666;">
          Please <%= link_to "login", login_path %> or <%= link_to "sign up", signup_path %> to checkout
        </p>
      <% end %>
    </div>
  </div>
<% else %>
  <div style="text-align: center; margin-top: 4rem;">
    <p style="color: #666; font-size: 1.2rem; margin-bottom: 2rem;">Your cart is empty</p>
    <%= link_to "Continue Shopping", products_path, style: "padding: 1rem 2rem; background: #007bff; color: white; text-decoration: none; border-radius: 4px; font-size: 1.1rem;" %>
  </div>
<% end %>
